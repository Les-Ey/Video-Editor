{
  "name": "splicewright",
  "version": "1.0.0",
  "author": {
    "name": "Les-Ey",
    "email": "les.ey@users.noreply.github.com"
  },
  "homepage": "https://github.com/Les-Ey/Video-Editor",
  "description": "SpliceWright — Local-First Video Editor for AI Movies & Standalone Projects",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "generate:sample": "node scripts/generate-sample-project.mjs"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "org.splicewright.editor",
    "productName": "SpliceWright",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpliceWright",
      "artifactName": "SpliceWright-${version}-Setup.exe"
    },
    "portable": {
      "artifactName": "SpliceWright-${version}-Portable.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "SpliceWright-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Video;AudioVideo",
      "maintainer": "Les-Ey <les.ey@users.noreply.github.com>",
      "synopsis": "Local-First AI Movie & Video Editor",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "SpliceWright-${version}-${arch}.${ext}"
    }
  }
}
